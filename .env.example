# Gemini (server only, never expose to the browser)
GEMINI_API_KEY=
# Use the current Gemini Live model name shown in Google AI Studio / the Live API docs
GEMINI_LIVE_MODEL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# local setup only, never use in app code, never add to Vercel
SUPABASE_DB_URL=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOW_STOCK_THRESHOLD=5
